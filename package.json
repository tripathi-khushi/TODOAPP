{
  "name": "smartech-todo-app",
  "version": "1.0.0",
  "description": "Full-stack Multi-Page React and Express/MongoDB Todo Application matching the Smartech Pastel aesthetic",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "server": "nodemon server/server.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client run build",
    "db:view": "npm --prefix server run db:view",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install"
  },
  "keywords": [
    "todo",
    "react",
    "express",
    "mongodb",
    "mongoose",
    "multi-page-application",
    "mpa",
    "vite"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.0"
  }
}
